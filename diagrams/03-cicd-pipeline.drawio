        <mxCell id="metrics" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#666666;strokeWidth=2;fontSize=10;fontStyle=1;align=center" value="PIPELINE METRICS&#xa;━━━━━━━━━━━━━━&#xa;Total Time: ~40s&#xa;━━━━━━━━━━━━━━&#xa;Quality: 30s&#xa;Test: 2s&#xa;Evals: 5s&#xa;Deploy: 3s&#xa;━━━━━━━━━━━━━━&#xa;Success Rate: 95%&#xa;False Positive: &lt;1%&#xa;━━━━━━━━━━━━━━&#xa;Cost per Run: $0.01" vertex="1">
