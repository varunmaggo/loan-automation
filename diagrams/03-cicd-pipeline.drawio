        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" value="CI/CD Pipeline: Quality → Test → Evals → Merge" vertex="1">
          <mxGeometry height="40" width="1000" x="150" y="230" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=2;fontColor=#666666" value="Automated Gates | Zero Manual Review | Fail Fast | Deploy with Confidence" vertex="1">
          <mxGeometry height="30" width="1000" x="140" y="260" as="geometry" />
        </mxCell>
        <mxCell id="pr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9999FF;strokeColor=#0057A8;strokeWidth=2;fontSize=11;fontStyle=1;align=center" value="Pull Request&#xa;━━━━━━━━━━━━━━&#xa;Developer Submits&#xa;━━━━━━━━━━━━━━&#xa;Code Changes&#xa;New Features&#xa;Bug Fixes&#xa;━━━━━━━━━━━━━━&#xa;Triggers Pipeline" vertex="1">
          <mxGeometry height="150" width="140" x="80" y="400" as="geometry" />
        </mxCell>
        <mxCell id="quality" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0057A8;strokeColor=#ffffff;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#ffffff;align=center" value="Quality Gate&#xa;━━━━━━━━━━━━━━&#xa;Static Analysis&#xa;━━━━━━━━━━━━━━&#xa;✓ ruff (linting)&#xa;✓ mypy (types)&#xa;✓ bandit (security)&#xa;✓ pip-audit (deps)&#xa;━━━━━━━━━━━━━━&#xa;⏱ ~30 seconds&#xa;━━━━━━━━━━━━━━&#xa;BUSINESS AREA:&#xa;Code Quality" vertex="1">
          <mxGeometry height="190" width="150" x="280" y="380" as="geometry" />
        </mxCell>
        <mxCell id="test" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0097A7;strokeColor=#ffffff;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#ffffff;align=center" value="Test Suite&#xa;━━━━━━━━━━━━━━&#xa;Unit + Integration&#xa;━━━━━━━━━━━━━━&#xa;✓ pytest&#xa;✓ ≥85% coverage&#xa;✓ 12 tests&#xa;━━━━━━━━━━━━━━&#xa;⏱ ~2 seconds&#xa;━━━━━━━━━━━━━━&#xa;BUSINESS AREA:&#xa;Functional&#xa;Correctness" vertex="1">
          <mxGeometry height="190" width="150" x="490" y="380" as="geometry" />
        </mxCell>
        <mxCell id="evals" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00853F;strokeColor=#ffffff;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#ffffff;align=center" value="DeepEval Suite&#xa;━━━━━━━━━━━━━━&#xa;3-Tier Metrics&#xa;━━━━━━━━━━━━━━&#xa;✓ Policy (0.85)&#xa;✓ Schema (0.90)&#xa;✓ Exact Match (0.90)&#xa;✓ Fairness Check&#xa;━━━━━━━━━━━━━━&#xa;⏱ ~5 seconds&#xa;━━━━━━━━━━━━━━&#xa;BUSINESS AREA:&#xa;Compliance &amp;&#xa;Fairness" vertex="1">
          <mxGeometry height="190" width="150" x="700" y="380" as="geometry" />
        </mxCell>
        <mxCell id="merge" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9999FF;strokeColor=#00853F;strokeWidth=3;fontSize=10;fontStyle=1;align=center" value="✓ MERGE&#xa;━━━━━━━━━━━━━━&#xa;All Gates Passed&#xa;━━━━━━━━━━━━━━&#xa;Auto-Merge to Main&#xa;Deploy Ready&#xa;━━━━━━━━━━━━━━&#xa;Confidence: HIGH&#xa;━━━━━━━━━━━━━━&#xa;BUSINESS IMPACT:&#xa;Fast Delivery&#xa;Zero Manual Review" vertex="1">
          <mxGeometry height="180" width="160" x="950" y="320" as="geometry" />
        </mxCell>
        <mxCell id="block" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#FF0000;strokeWidth=3;fontSize=10;fontStyle=1;fontColor=#CC0000;align=center" value="✗ BLOCK&#xa;━━━━━━━━━━━━━━&#xa;Gate Failed&#xa;━━━━━━━━━━━━━━&#xa;Merge Blocked&#xa;Fix Required&#xa;━━━━━━━━━━━━━━&#xa;Developer Notified&#xa;━━━━━━━━━━━━━━&#xa;BUSINESS IMPACT:&#xa;Prevent Bad Code&#xa;Maintain Quality" vertex="1">
          <mxGeometry height="180" width="160" x="950" y="540" as="geometry" />
