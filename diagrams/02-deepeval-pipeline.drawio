        <mxCell id="fail" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#FF0000;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#CC0000;align=center" value="✗ FAIL&#xa;━━━━━━━━━━━━━━&#xa;Threshold Violated&#xa;━━━━━━━━━━━━━━&#xa;Block Merge&#xa;━━━━━━━━━━━━━━&#xa;Fix Required" vertex="1">
          <mxGeometry height="120" width="140" x="1040" y="560" as="geometry" />
