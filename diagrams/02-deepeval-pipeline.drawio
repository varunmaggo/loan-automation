        </mxCell>
        
        <!-- Tier 1 Metrics with Details -->
        <mxCell id="tier1" value="TIER 1: Deterministic&#xa;━━━━━━━━━━━━━━&#xa;PolicyComplianceMetric&#xa;Threshold: 0.85&#xa;━━━━━━━━━━━━━━&#xa;SchemaValidityMetric&#xa;Threshold: 0.90&#xa;━━━━━━━━━━━━━━&#xa;ExactMatchMetric&#xa;Threshold: 0.90&#xa;━━━━━━━━━━━━━━&#xa;✓ Fast execution&#xa;✓ No LLM required&#xa;✓ Every PR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0097A7;strokeColor=#ffffff;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#ffffff;align=center" vertex="1" parent="1">
          <mxGeometry x="540" y="280" width="180" height="200" as="geometry"/>
