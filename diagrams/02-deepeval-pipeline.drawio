        <mxCell id="impact" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#666666;strokeWidth=2;fontSize=10;fontStyle=1;align=center" value="BUSINESS IMPACT&#xa;━━━━━━━━━━━━━━&#xa;100% Policy Compliance&#xa;Automated Fairness Checks&#xa;Explainable Metrics&#xa;CI/CD Integration&#xa;━━━━━━━━━━━━━━&#xa;Reduces Manual Review&#xa;Catches Bias Early&#xa;Ensures Consistency" vertex="1">
