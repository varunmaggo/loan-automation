<mxfile host="Electron">
  <diagram id="deepeval-pipeline" name="DeepEval Pipeline">
    <mxGraphModel dx="1762" dy="889" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-main" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" value="DeepEval Three-Tier Evaluation Pipeline" vertex="1">
          <mxGeometry height="40" width="800" x="300" y="180" as="geometry" />
        </mxCell>
        <mxCell id="subtitle-main" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=2;fontColor=#666666" value="Deterministic Metrics | Fairness Analysis | LLM Judge | CI/CD Integration" vertex="1">
          <mxGeometry height="30" width="800" x="290" y="210" as="geometry" />
        </mxCell>
        <mxCell id="input" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#99CCFF;strokeColor=#0057A8;strokeWidth=2;fontSize=12;fontStyle=1;align=center" value="LoanApplication&#xa;Test Input&#xa;━━━━━━━━━━━━━━&#xa;8 Test Cases&#xa;━━━━━━━━━━━━━━&#xa;• Prime (3)&#xa;• Near-Prime (3)&#xa;• High-Risk (2)&#xa;━━━━━━━━━━━━━━&#xa;Labeled Dataset" vertex="1">
          <mxGeometry height="180" width="160" x="80" y="450" as="geometry" />
        </mxCell>
        <mxCell id="fleet" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0057A8;strokeColor=#ffffff;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#ffffff;align=center" value="Fleet Run&#xa;━━━━━━━━━━━━━━&#xa;Multi-Agent System&#xa;━━━━━━━━━━━━━━&#xa;Orchestrator&#xa;+ 4 Specialists&#xa;+ Decision Agent&#xa;━━━━━━━━━━━━━━&#xa;Produces:&#xa;• Decision JSON&#xa;• Tool Outputs&#xa;• Message History" vertex="1">
          <mxGeometry height="180" width="160" x="300" y="450" as="geometry" />
        </mxCell>
        <mxCell id="tier1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0097A7;strokeColor=#ffffff;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#ffffff;align=center" value="TIER 1: Deterministic&#xa;━━━━━━━━━━━━━━&#xa;PolicyComplianceMetric&#xa;Threshold: 0.85&#xa;━━━━━━━━━━━━━━&#xa;SchemaValidityMetric&#xa;Threshold: 0.90&#xa;━━━━━━━━━━━━━━&#xa;ExactMatchMetric&#xa;Threshold: 0.90&#xa;━━━━━━━━━━━━━━&#xa;✓ Fast execution&#xa;✓ No LLM required&#xa;✓ Every PR" vertex="1">
          <mxGeometry height="200" width="180" x="540" y="280" as="geometry" />
        </mxCell>
        <mxCell id="tier2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0057A8;strokeColor=#ffffff;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#ffffff;align=center" value="TIER 2: Slice Analysis&#xa;━━━━━━━━━━━━━━&#xa;slice_disparity()&#xa;━━━━━━━━━━━━━━&#xa;Approval Rate by Band:&#xa;• Prime: 100%&#xa;• Near-Prime: 0%&#xa;• High-Risk: 0%&#xa;━━━━━━━━━━━━━━&#xa;Fairness Gate&#xa;Bias Detection&#xa;━━━━━━━━━━━━━━&#xa;✓ Every PR" vertex="1">
          <mxGeometry height="180" width="180" x="540" y="510" as="geometry" />
        </mxCell>
        <mxCell id="tier3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#002855;strokeColor=#ffffff;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#ffffff;align=center;dashed=1;dashPattern=5 5" value="TIER 3: LLM Judge&#xa;━━━━━━━━━━━━━━&#xa;GEval&#xa;ReasonsGroundedness&#xa;━━━━━━━━━━━━━━&#xa;Threshold: 0.70&#xa;━━━━━━━━━━━━━━&#xa;Reasoning Quality&#xa;Coherence Check&#xa;━━━━━━━━━━━━━━&#xa;⚠ Optional (Nightly)&#xa;⚠ Requires API key&#xa;⚠ RUN_GEVAL=1" vertex="1">
          <mxGeometry height="180" width="180" x="550" y="740" as="geometry" />
        </mxCell>
        <mxCell id="cigate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00853F;strokeColor=#ffffff;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#ffffff;align=center" value="CI Gate&#xa;━━━━━━━━━━━━━━&#xa;Threshold Check&#xa;━━━━━━━━━━━━━━&#xa;fail_build_if_any&#xa;_below_threshold&#xa;━━━━━━━━━━━━━━&#xa;Required Metrics:&#xa;• PolicyCompliance&#xa;• SchemaValidity&#xa;━━━━━━━━━━━━━━&#xa;Automated Decision" vertex="1">
          <mxGeometry height="180" width="160" x="800" y="470" as="geometry" />
        </mxCell>
        <mxCell id="pass" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5EDDF;strokeColor=#00853F;strokeWidth=3;fontSize=12;fontStyle=1;align=center" value="✓ PASS&#xa;━━━━━━━━━━━━━━&#xa;All Gates Passed&#xa;━━━━━━━━━━━━━━&#xa;Ready to Merge&#xa;━━━━━━━━━━━━━━&#xa;Deploy to Prod" vertex="1">
          <mxGeometry height="120" width="140" x="1040" y="400" as="geometry" />
