# Model configuration
MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=your-api-key-here

# Runtime configuration
LIVE_MODE=false
MAX_TOOL_CALLS=8
MAX_WALLCLOCK_SECONDS=30
MAX_COST_USD=0.25

# Security
PII_REDACTION=true
AGENT_SHARED_SECRET=demo-shared-secret-do-not-use-in-prod

# Artifact storage
ARTIFACT_DIR=./artifacts

# Evaluation
DEEPEVAL_TELEMETRY_OPT_OUT=YES
RUN_GEVAL=false
